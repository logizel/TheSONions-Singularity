# Copy to .env and fill in. NEVER commit a real .env.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# HMAC key for the signed `session` cookie checked by middleware.ts.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# OSRM server for GET /api/route. Empty = public demo server
# (https://router.project-osrm.org): fair-use only, no SLA; demo use only.
ROUTING_BASE_URL=

# Demo sign-in at /sign-in and the top-bar role switcher (prototype only).
# Anything other than "true" disables both.
DEMO_AUTH=

# Map tiles. Empty = OpenStreetMap standard tiles (attribution is always shown).
NEXT_PUBLIC_TILE_URL=
